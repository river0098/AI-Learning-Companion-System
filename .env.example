# AI Learning Companion System - Environment Variables
# Copy this file to .env and fill in your values

# System
ENVIRONMENT=development
DEBUG_MODE=true

# Database
DATABASE_URL=sqlite:///data/companion.db
# For PostgreSQL: postgresql://user:password@localhost/companion_db

# API Keys (Optional - for cloud features)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_CLOUD_API_KEY=your_google_cloud_api_key_here

# Encryption
ENCRYPTION_KEY=your_secret_encryption_key_here
SECRET_KEY=your_secret_key_for_sessions_here

# Privacy Settings
SAVE_RAW_IMAGES=false
DATA_RETENTION_DAYS=90

# Camera
CAMERA_DEVICE_ID=0

# Server
API_HOST=0.0.0.0
API_PORT=8000

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/companion.log
