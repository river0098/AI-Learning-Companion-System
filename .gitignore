# AI Learning Companion System - Git Ignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
venv/
env/
ENV/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Environment Variables
.env
.env.local
.env.production

# Data (Privacy-safe - don't commit user data)
data/*.db
data/*.sqlite
data/samples/*
data/models/*
!data/samples/.gitkeep
!data/models/.gitkeep

# Logs
logs/
*.log

# Jupyter Notebooks
.ipynb_checkpoints/
*.ipynb

# Testing
.coverage
.pytest_cache/
htmlcov/
.tox/
.nox/

# Database
*.db
*.sqlite
*.sqlite3

# Temporary files
*.tmp
*.temp
temp/
tmp/

# OS
Thumbs.db
.DS_Store

# Camera snapshots (NEVER commit - privacy)
snapshots/
frames/
images/student_*

# Node modules (for frontend)
node_modules/
.npm
.pnpm-store/

# Frontend build
frontend/dist/
frontend/build/

# Backup files
*.bak
*.backup

# Large model files (use Git LFS or download separately)
*.onnx
*.pt
*.pth
*.h5
*.pb
